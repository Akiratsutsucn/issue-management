# 复制为 .env 后填写。真实值不要提交到仓库。

# 数据库密码（compose 用于初始化 postgres 与拼接 DATABASE_URL）
POSTGRES_PASSWORD=
# 本地开发直接运行 next dev 时使用
DATABASE_URL=

# 会话签名密钥，至少 32 位随机字符。生成：openssl rand -base64 48
AUTH_SECRET=
APP_BASE_URL=http://localhost:3000
TZ=Asia/Shanghai
STORAGE_ROOT=./storage
STORAGE_DRIVER=local

# 停掉提醒任务时设为 false（课题读写不受影响）
REMINDERS_ENABLED=true

# 仅首次初始化管理员；创建成功后从环境中移除
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 端口绑定（内网部署可设为内网地址）
APP_BIND=127.0.0.1
APP_PORT=3000
# 构建时 npm 源（国内可用 https://registry.npmmirror.com/）
NPM_REGISTRY=https://registry.npmjs.org/
